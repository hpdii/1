<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_dark">

    <!-- PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/ivVideoThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Center pause / play icon (TikTok style play triangle) -->
    <ImageView
        android:id="@+id/ivPlayIndicator"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_indicator"
        android:padding="16dp"
        android:src="@drawable/ic_play_arrow"
        android:visibility="gone" />

    <!-- Buffering indicator -->
    <ProgressBar
        android:id="@+id/progressBarBuffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Bottom gradient shadow (160dp instead of 260dp, hidden in landscape) -->
    <View
        android:id="@+id/vGradientShadow"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_video_gradient" />

    <!-- Bottom video info (Left side) -->
    <LinearLayout
        android:id="@+id/layoutBottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="76dp"
        android:layout_marginBottom="80dp"
        android:orientation="vertical">

        <!-- Author row (clickable to view profile) -->
        <LinearLayout
            android:id="@+id/layoutAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/ivAuthorAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_button_primary" />

                <TextView
                    android:id="@+id/tvAuthorAvatarChar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="U"
                    android:textColor="@color/color_text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@username"
                android:textColor="@color/color_text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tiêu đề video"
            android:textColor="@color/color_text_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Mô tả video..."
            android:textColor="@color/color_text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Right side action buttons (TikTok style) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="76dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 1. Like / Heart button -->
        <LinearLayout
            android:id="@+id/btnLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_favorite_border_white" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@color/color_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 2. Comment button -->
        <LinearLayout
            android:id="@+id/btnComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivComment"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_comment_white" />

            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@color/color_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 3. Bookmark / Lưu video button -->
        <LinearLayout
            android:id="@+id/btnBookmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivBookmark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bookmark_border" />

            <TextView
                android:id="@+id/tvBookmarkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lưu"
                android:textColor="@color/color_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 4. Share button -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chia sẻ"
                android:textColor="@color/color_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 5. More Options (3 chấm ⋮) -->
        <LinearLayout
            android:id="@+id/btnMoreOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_more_vert_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Thêm"
                android:textColor="@color/color_text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Video Scrubber (SeekBar + Duration) -->
    <LinearLayout
        android:id="@+id/layoutScrubber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/color_text_white"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seekBarVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progress="0"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/color_favorite"
            android:thumb="@drawable/thumb_seekbar"
            android:thumbTint="@color/color_text_white" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/color_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</FrameLayout>
